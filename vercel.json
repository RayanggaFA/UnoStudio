{
  "redirects": [
    {
      "source": "/",
      "destination": "/Uno%20Studio.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "unostudio.id"
        }
      ],
      "destination": "https://www.unostudio.id/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}